# The Render API server's URL (same value the old overwatch.js hardcoded as API_BASE).
# Leave empty for local dev if you're serving the frontend from the same origin as the
# API - set it whenever the frontend is deployed separately (e.g. on Netlify).
VITE_API_BASE=https://overwatch-0bic.onrender.com

# From your Supabase project's Settings -> API. The anon key is safe to expose in the
# client bundle - Supabase's security boundary is RLS + auth, not key secrecy.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
