# Which food-identification backend to use: "grubwatch" (default, chains Purdue GenAI Studio then
# Gemini's free tier as cloud vision models) or "local" (runs models on this machine instead)
FOOD_DETECTOR=grubwatch

# When FOOD_DETECTOR=grubwatch, at least one of PURDUE_GENAI_API_KEY or GEMINI_API_KEY is required.

# Get a key from genai.rcac.purdue.edu -> avatar -> Settings -> Account -> API Keys
PURDUE_GENAI_API_KEY=your-purdue-genai-api-key
PURDUE_GENAI_MODEL=llama4:latest
PURDUE_GENAI_FALLBACK_MODEL=gemma4:26b-a4b

# Used if both Purdue models above fail (e.g. during a Purdue GenAI Studio outage), or if
# PURDUE_GENAI_API_KEY isn't set at all. Get a free key (no credit card) from
# aistudio.google.com -> Get API Key.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest

# Used when FOOD_DETECTOR=local (downloads and runs this model locally, no external API calls)
LOCAL_MODEL_ID=onnx-community/swin-finetuned-food101-ONNX

# Shared key used for every signed-in user's free daily Wolfram Alpha lookups (see
# WOLFRAM_DAILY_FREE_LOOKUPS below). Get one from developer.wolframalpha.com.
WOLFRAM_APP_ID=your-wolfram-alpha-app-id

# How many free /api/nutrition-image lookups/day each user gets against the shared
# WOLFRAM_APP_ID above before hitting a 429. Users can add their own personal Wolfram App
# ID in the app's Settings panel to bypass this cap entirely. Optional - defaults to 5.
WOLFRAM_DAILY_FREE_LOOKUPS=5

# Required for accounts (both real web logins and the installed PWA's anonymous sessions).
# From your Supabase project's Settings -> API. SUPABASE_SERVICE_ROLE_KEY bypasses Row
# Level Security - keep it server-side only, never expose it to the frontend.
# Also run supabase/schema.sql in your project's SQL Editor and enable Anonymous
# Sign-Ins under Authentication -> Providers (off by default) - see README.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# The origin allowed to call this API cross-origin (your static front end's URL, if hosted
# separately from this server - e.g. on Netlify). Defaults to https://grubwatch.netlify.app if unset.
NETLIFY_ORIGIN=https://grubwatch.netlify.app

# Optional - defaults to 3000
PORT=3000
