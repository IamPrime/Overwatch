# Which food-identification backend to use: "purdue-genai" (default) or "local"
FOOD_DETECTOR=purdue-genai

# Required when FOOD_DETECTOR=purdue-genai
# Get a key from genai.rcac.purdue.edu -> avatar -> Settings -> Account -> API Keys
PURDUE_GENAI_API_KEY=your-purdue-genai-api-key
PURDUE_GENAI_MODEL=llama4:latest
PURDUE_GENAI_FALLBACK_MODEL=gemma4:26b-a4b

# Used when FOOD_DETECTOR=local (downloads and runs this model locally, no external API calls)
LOCAL_MODEL_ID=onnx-community/swin-finetuned-food101-ONNX

# Required always - get a Wolfram Alpha App ID from developer.wolframalpha.com
WOLFRAM_APP_ID=your-wolfram-alpha-app-id

# Optional - defaults to 3000
PORT=3000
